# =========================================================================
# Afrique-Con Staging Environment Secrets & Configuration Template
# Copy this file to '.env' and modify credentials.
# Store production-ready versions in your secrets manager (e.g. AWS Secrets Manager / GCP Secret Manager).
# =========================================================================

# --- BUEA BRANCH DATABASE CONFIGURATION ---
BUEA_DB_USER=buea_db_admin
BUEA_DB_PASSWORD=choose_a_strong_password_buea
BUEA_DB_NAME=buea_staging_db

# --- DOUALA AKWA BRANCH DATABASE CONFIGURATION ---
DOUALA_DB_USER=douala_db_admin
DOUALA_DB_PASSWORD=choose_a_strong_password_douala
DOUALA_DB_NAME=douala_staging_db

# --- STAGING PG_BOUNCER CONNECTION STRINGS (STORE IN SECRETS MANAGER) ---
# Buea Staging connection through pooler (port 5433 mapped locally)
BUEA_DATABASE_URL=postgresql://buea_db_admin:choose_a_strong_password_buea@localhost:5433/buea_staging_db

# Douala Akwa Staging connection through pooler (port 5434 mapped locally)
DOUALA_DATABASE_URL=postgresql://douala_db_admin:choose_a_strong_password_douala@localhost:5434/douala_staging_db

# --- STAGING REDIS CONFIGURATION ---
REDIS_STAGING_HOST=localhost
REDIS_STAGING_PORT=6379
REDIS_PASSWORD=choose_a_strong_password_redis
REDIS_STAGING_URL=redis://:choose_a_strong_password_redis@localhost:6379/0

